{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecommerce-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",

  // The frontend, BETTER_AUTH_URL and FRONTEND_ORIGIN all target this exact
  // origin. Pinning it makes a port conflict fail loudly instead of silently
  // moving the API to another port and breaking browser requests.
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },

  // Add nodejs_compat compatibility flag to support common database drivers
  "compatibility_flags": ["nodejs_compat"],

  // Add this to your wrangler.jsonc
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0c6bae39855446449b1276eecf3dd4d3",
    },
  ],
  "r2_buckets": [
    {
      "binding": "KYC_BUCKET",
      "bucket_name": "ecommerce-admin-kyc-private",
    },
    {
      "binding": "PRODUCT_IMAGES_BUCKET",
      "bucket_name": "shop-product-images",
      // remote: true is only for accessing real R2 during local development.
      // Deployment binds this bucket without remote: true.
    },
  ],
}
