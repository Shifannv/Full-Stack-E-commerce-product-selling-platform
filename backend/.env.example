# ==============================
# AIVEN POSTGRESQL
# ==============================

DATABASE_URL=

# ==============================
# BETTER AUTH
# ==============================

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8787
FRONTEND_ORIGIN=http://127.0.0.1:3000

# ==============================
# GOOGLE OAUTH
# ==============================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register http://127.0.0.1:8787/api/auth/callback/google for local browser verification.

# ==============================
# UPSTASH REDIS
# ==============================

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================
# RESEND
# Add when email module starts
# ==============================

RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Production requires HTTPS. Only this exact HTTP loopback origin is allowed locally.
ADMIN_SETUP_URL=http://127.0.0.1:3000/admin/setup

# ==============================
# CASHFREE PAYMENT
# Server-only Payment Gateway keys. Use SANDBOX keys for sandbox checks.
# ==============================

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=SANDBOX

# ==============================
# CASHFREE PAYOUT
# Add when payout module starts
# ==============================

PAYOUT_CLIENT_ID=
PAYOUT_CLIENT_SECRET=
PAYOUT_ENVIRONMENT=SANDBOX

# SHIPROCKET (Worker-side only; keep actual values in .dev.vars or Worker secrets)
SHIPPING_PROVIDER=shiprocket
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_WEBHOOK_TOKEN=

# Finalized policy: five days from orders.delivered_at.
RETURN_WINDOW_DAYS=5
