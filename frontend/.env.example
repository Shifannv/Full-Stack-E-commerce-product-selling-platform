# Public browser configuration. Set production values in Cloudflare Pages.
# In production NEXT_PUBLIC_API_URL points at the Pages origin itself so
# every API fetch is same-origin and session cookies are first-party; the
# frontend/functions/api/[[path]].ts Pages Function then proxies /api/*
# to the Worker at PUBLIC_WORKER_URL (Pages project env).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
